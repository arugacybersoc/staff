{
  "$schema": "https://adaptivecards.microsoft.com/schemas/adaptive-card-2026-01-13.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "fallbackText": "Security incident #@{triggerBody()?['object']?['properties']?['incidentNumber']}: @{triggerBody()?['object']?['properties']?['title']}",
  "speak": "Security incident number @{triggerBody()?['object']?['properties']?['incidentNumber']}. Severity @{variables('Severity')}. @{variables('Simplified Description')}",
  "msteams": {
    "width": "full"
  },
  "body": [
    {
      "type": "Container",
      "id": "ticketSurface",
      "bleed": true,
      "backgroundImage": {
        "url": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mPgFxD4DwABkAEvD+fKowAAAABJRU5ErkJggg==",
        "fillMode": "Cover"
      },
      "items": [
        {
          "type": "Container",
          "id": "incidentHeader",
          "bleed": true,
          "items": [
            {
              "type": "ColumnSet",
              "columns": [
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    {
                      "type": "ColumnSet",
                      "spacing": "Medium",
                      "columns": [
                        {
                          "type": "Column",
                          "width": "auto",
                          "items": [
                            {
                              "type": "TextBlock",
                              "text": "@{toUpper(variables('Severity'))}",
                              "color": "@{variables('Temperature')}",
                              "size": "Small",
                              "weight": "Bolder",
                              "wrap": true
                            }
                          ]
                        },
                        {
                          "type": "Column",
                          "width": "stretch",
                          "items": [
                            {
                              "type": "TextBlock",
                              "text": "INCIDENT #@{triggerBody()?['object']?['properties']?['incidentNumber']}",
                              "color": "Light",
                              "size": "Small",
                              "weight": "Bolder",
                              "wrap": true
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "Container",
                      "id": "alertTitleSearchLogs",
                      "spacing": "Small",
                      "selectAction": {
                        "type": "Action.OpenUrl",
                        "title": "Search Logs",
                        "url": "SearchLogs69",
                        "tooltip": "Open the alerted events and related logs"
                      },
                      "items": [
                        {
                          "type": "TextBlock",
                          "text": "@{toUpper(triggerBody()?['object']?['properties']?['title'])}",
                          "color": "Light",
                          "size": "ExtraLarge",
                          "weight": "Bolder",
                          "wrap": true,
                          "maxLines": 3,
                          "spacing": "None",
                          "targetWidth": "atLeast:Standard"
                        },
                        {
                          "type": "TextBlock",
                          "text": "@{toUpper(triggerBody()?['object']?['properties']?['title'])}",
                          "color": "Light",
                          "size": "Medium",
                          "weight": "Bolder",
                          "wrap": true,
                          "maxLines": 3,
                          "spacing": "None",
                          "targetWidth": "atMost:Narrow"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "auto",
                  "verticalContentAlignment": "Center",
                  "items": [
                    {
                      "type": "Image",
                      "url": "https://raw.githubusercontent.com/arugacybersoc/staff/main/Arugalogo_Trans.png",
                      "altText": "Aruga Cyber",
                      "width": "140px",
                      "horizontalAlignment": "Right",
                      "targetWidth": "atLeast:Standard",
                      "selectAction": {
                        "type": "Action.OpenUrl",
                        "url": "Arugasneaky69"
                      }
                    },
                    {
                      "type": "Image",
                      "url": "https://raw.githubusercontent.com/arugacybersoc/staff/main/Arugalogo_Trans.png",
                      "altText": "Aruga Cyber",
                      "width": "70px",
                      "horizontalAlignment": "Right",
                      "targetWidth": "atMost:Narrow",
                      "selectAction": {
                        "type": "Action.OpenUrl",
                        "url": "Arugasneaky69"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "TextBlock",
              "text": "@{variables('Simplified Description')}",
              "color": "Light",
              "size": "Medium",
              "wrap": true,
              "separator": true,
              "spacing": "Large",
              "targetWidth": "atLeast:Standard"
            },
            {
              "type": "TextBlock",
              "text": "@{variables('Simplified Description')}",
              "color": "Light",
              "size": "Small",
              "wrap": true,
              "separator": true,
              "spacing": "Large",
              "targetWidth": "atMost:Narrow"
            },
            {
              "type": "Container",
              "id": "allowListMatch",
              "separator": true,
              "spacing": "Large",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "ALLOW-LIST MATCH",
                  "color": "Light",
                  "size": "Small",
                  "weight": "Bolder",
                  "wrap": true
                }
              ]
            }
          ],
          "spacing": "None",
          "separator": false,
          "showBorder": false,
          "roundedCorners": false
        }
      ],
      "spacing": "None",
      "separator": false,
      "style": "default",
      "showBorder": false,
      "roundedCorners": false
    },
    {
      "type": "Container",
      "id": "investigatingState",
      "isVisible": true,
      "showBorder": false,
      "roundedCorners": false,
      "separator": false,
      "spacing": "None",
      "bleed": true,
      "style": "default",
      "items": [
        {
          "type": "Image",
          "id": "investigatingThemeImage",
          "url": "https://raw.githubusercontent.com/arugacybersoc/staff/main/Aruga_Background_Cycle_10s.gif",
          "themedUrls": [
            {
              "theme": "Light",
              "url": "https://raw.githubusercontent.com/arugacybersoc/staff/main/Aruga_Background_Cycle_10s_Light.gif"
            },
            {
              "theme": "Dark",
              "url": "https://raw.githubusercontent.com/arugacybersoc/staff/main/Aruga_Background_Cycle_10s.gif"
            }
          ],
          "altText": "Awaiting analyst assignment",
          "size": "Stretch",
          "horizontalAlignment": "Center",
          "spacing": "None",
          "width": "stretch",
          "height": "250px",
          "fitMode": "Cover",
          "horizontalContentAlignment": "Center",
          "verticalContentAlignment": "Center"
        }
      ]
    },
    {
      "type": "Container",
      "id": "actionsSurface",
      "bleed": true,
      "spacing": "None",
      "separator": false,
      "style": "default",
      "showBorder": false,
      "roundedCorners": false,
      "backgroundImage": {
        "url": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNgYGBgAAAABQABeqhXUAAAAABJRU5ErkJggg==",
        "fillMode": "Cover",
        "horizontalAlignment": "Center",
        "verticalAlignment": "Center",
        "themedUrls": [
          {
            "theme": "Light",
            "url": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP4////fwAJ+wP99djxmgAAAABJRU5ErkJggg=="
          },
          {
            "theme": "Dark",
            "url": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNgYGD4DwABBAEAgLvRWwAAAABJRU5ErkJggg=="
          }
        ]
      },
      "items": [
        {
          "type": "ColumnSet",
          "separator": true,
          "spacing": "Large",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "ActionSet",
                  "spacing": "Medium",
                  "actions": [
                    {
                      "type": "Action.OpenUrl",
                      "url": "@{triggerBody()?['object']?['properties']?['incidentUrl']}",
