                                  "wrap": true,
                                  "spacing": "Small"
                                },
                                {
                                  "type": "TextBlock",
                                  "text": "@{if(equals(body('MAPBOX_LOGIC')?['hasResults'], true), '', 'No sign-in map data available.')}",
