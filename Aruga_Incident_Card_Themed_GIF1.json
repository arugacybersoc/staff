                                  "weight": "Bolder",
                                  "spacing": "Large",
                                  "horizontalAlignment": "Left"
                                },
                                {
                                  "type": "TextBlock",
                                  "text": "@{body('PIM_LOGIC')}",
                                  "color": "Default",
                                  "wrap": true,
                                  "spacing": "Small",
                                  "size": "Small",
                                  "horizontalAlignment": "Left"
                                }
                              ],
                              "isVisible": true
                            }
                          ]
                        },
                        {
                          "type": "Column",
                          "width": "12px",
                          "items": []
                        }
                      ]
                    }
                  ],
                  "spacing": "Small"
                }
              ]
            }
          ],
          "style": "default",
          "separator": false
        },
        {
          "type": "Container",
          "separator": true,
          "spacing": "Medium",
          "items": [
            {
              "type": "TextBlock",
              "text": "Generated @{formatDateTime(convertTimeZone(utcNow(), 'UTC', 'GMT Standard Time'), 'dd/MM/yyyy HH:mm:ss')} UK time",
              "color": "Default",
              "size": "Small",
              "isSubtle": true,
              "horizontalAlignment": "Center",
