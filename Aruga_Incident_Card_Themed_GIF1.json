              "spacing": "None",
              "verticalContentAlignment": "Center"
            },
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "ActionSet",
                  "spacing": "Medium",
                  "actions": [
                    {
                      "type": "Action.OpenUrl",
                      "url": "REMEDIATION69",
                      "tooltip": "Open remediation",
                      "title": "Actions",
                      "style": "default",
                      "isEnabled": true
